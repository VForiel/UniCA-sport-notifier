# ==========================================
# UniCA Sport Notifier - Configuration
# ==========================================

# Clé secrète Django (OBLIGATOIRE en production)
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production

# Mode débogage (True en dev, False en prod)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Domaines CSRF de confiance
CSRF_TRUSTED_ORIGINS=https://votre-domaine.fr,http://localhost:8000

# Fuseau horaire (Strictement Europe/Paris selon le cahier des charges)
TIME_ZONE=Europe/Paris

# Clé de chiffrement réversible Fernet pour les identifiants UniCA
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YOUR_GENERATED_FERNET_KEY_HERE_BASE64==

# Base de données PostgreSQL (en Docker ou local)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=sqlite:///db.sqlite3
# En production Docker :
# DATABASE_URL=postgres://unicasport:unicasecret@db:5432/unicasport_db

# Broker Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Superadministrateur initial
DEFAULT_SUPERUSER_EMAIL=vincent.foriel@gmail.com

# Configuration WebPush VAPID
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:vincent.foriel@gmail.com

# Configuration SMTP (optionnel ici, modifiable aussi dans ServerSettings en admin)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=UniCA Sport Notifier <notifications@votre-domaine.fr>

# Notifications Externes (Optionnels ici, modifiables aussi dans ServerSettings en admin)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
