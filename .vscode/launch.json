{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Lancer le serveur web",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Celery: Worker (Mode solo Windows)",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A", "config",
        "worker",
        "-l", "INFO",
        "-P", "solo",
        "-Q", "celery,notifications"
      ],
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Celery: Beat (Ordonnanceur)",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A", "config",
        "beat",
        "-l", "INFO"
      ],
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "UniCA: Simuler un événement de test (Notification)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["simulate_new_event"],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "UniCA: Lancer un scan réel immédiat",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["run_scan_once"],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Tests: Exécuter la suite de tests unitaires",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["test", "tests"],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
