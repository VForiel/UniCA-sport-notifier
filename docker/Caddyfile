# Caddyfile - Reverse Proxy avec TLS Let's Encrypt automatique
# Remplacez votre-domaine.fr par votre véritable domaine pointant vers ce serveur.

{$DOMAIN_NAME:localhost} {
    # Compression gzip et zstd automatique
    encode gzip zstd

    # Fichiers statiques servis directement par Caddy pour des performances optimales
    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }

    # Tout le reste est redirigé vers l'application Django Gunicorn
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    # Les en-têtes de sécurité (HSTS, CSP, X-Frame-Options…) sont posés par Django.
}
